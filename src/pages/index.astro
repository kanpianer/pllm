---
import Layout from '../layouts/Layout.astro';
import rawIssues from '../data/issues.json';

interface CommentItem {
  author: string;
  text: string;
  createdAt: string;
}

interface LabelItem {
  name: string;
  color: string;
}

interface IssueItem {
  id: number;
  title: string;
  state: string;
  url: string;
  createdAt: string;
  updatedAt: string;
  riskLevel: 'high' | 'warning' | 'resolved' | 'runaway' | 'archive';
  labels: LabelItem[];
  summary: string;
  body?: string;
  commentCount: number;
  reactionCount: number;
  latestComments: CommentItem[];
}

const issues = (rawIssues as IssueItem[]).sort(
  (a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
);

// KPI 统计计算（构建期静态生成）
const now = Date.now();
const DAY_MS = 86400000;

const recent7dCount = issues.filter(
  (i) => i.state === 'OPEN' && now - new Date(i.updatedAt).getTime() <= 7 * DAY_MS
).length;

const counts = {
  all: issues.length,
  high: issues.filter((i) => i.riskLevel === 'high').length,
  warning: issues.filter((i) => i.riskLevel === 'warning').length,
  resolved: issues.filter((i) => i.riskLevel === 'resolved').length,
  runaway: issues.filter((i) => i.riskLevel === 'runaway').length,
  archive: issues.filter((i) => i.riskLevel === 'archive').length,
};

const lastSyncedAt = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date());

const riskMeta = {
  high: { label: '预警 / 疑似跑路', className: 'badge-high' },
  warning: { label: '异常观察中', className: 'badge-warning' },
  resolved: { label: '已恢复 / 误报', className: 'badge-resolved' },
  runaway: { label: '已跑路', className: 'badge-runaway' },
  archive: { label: '归档', className: 'badge-archive' },
};

function formatDate(iso: string) {
  return new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(new Date(iso));
}
---

<Layout title="你的机场，跑路了吗？ | 机场跑路预警与状态追踪看板">
  <div data-pagefind-ignore>
    <!-- 1. KPI 态势栏：恢复原本颜色与发光特效，保留无边框设计 -->
    <section class="kpi-grid" aria-label="预警概览">
      <div class="kpi-card kpi-danger">
        <span class="kpi-label">当前预警</span>
        <strong class="kpi-value">{counts.high}</strong>
        <span class="kpi-sub">近期高频讨论 / 标记预警</span>
      </div>
      <div class="kpi-card kpi-warn">
        <span class="kpi-label">近 7 天活跃反馈</span>
        <strong class="kpi-value">{recent7dCount}</strong>
        <span class="kpi-sub">开启状态且 7 日内有动态</span>
      </div>
      <div class="kpi-card kpi-total">
        <span class="kpi-label">累计收录线索</span>
        <strong class="kpi-value">{counts.all}</strong>
        <span class="kpi-sub">含观察中 {counts.warning} 条</span>
      </div>
      <div class="kpi-card kpi-sync">
        <span class="kpi-label">最后同步 (UTC+8)</span>
        <strong class="kpi-value kpi-time">{lastSyncedAt}</strong>
        <span class="kpi-sub">GitHub Actions 自动更新</span>
      </div>
    </section>

    <!-- 2. Pagefind 全文搜索区 -->
    <section class="search-section" aria-label="全文检索">
      <div class="search-bar-row">
        <div class="search-title-stack" aria-label="买前搜一下">
          <div class="title-top"><span>买</span><span>前</span></div>
          <div class="title-bottom"><span>搜</span><span>一</span><span>下</span></div>
        </div>
        <div id="pagefind-search" class="search-input-wrap">
          <div class="search-placeholder-bar">
            <svg class="search-placeholder-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="search-fallback-input"
              class="search-fallback-input"
              placeholder="输入机场名称或失联、退款等关键词"
              aria-label="站内搜索"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 3. 风险等级筛选与排序控制条 -->
    <section class="toolbar" aria-label="筛选与排序">
      <div class="filter-pills" role="tablist">
        <button class="pill active" data-risk="all">
          全部 <span class="pill-count">{counts.all}</span>
        </button>
        <button class="pill" data-risk="high">
          🔴 预警 <span class="pill-count">{counts.high}</span>
        </button>
        <button class="pill" data-risk="warning">
          🟡 观察中 <span class="pill-count">{counts.warning}</span>
        </button>
        <button class="pill" data-risk="resolved">
          🟢 已恢复 <span class="pill-count">{counts.resolved}</span>
        </button>
        <button class="pill" data-risk="runaway">
          💀 已跑路 <span class="pill-count">{counts.runaway}</span>
        </button>
        <button class="pill" data-risk="archive">
          ⚪ 归档 <span class="pill-count">{counts.archive}</span>
        </button>
      </div>

      <div class="toolbar-selects">
        <select id="time-filter" aria-label="时间范围">
          <option value="all">全部时间</option>
          <option value="7">近 7 天活跃</option>
          <option value="30">近 30 天活跃</option>
        </select>

        <select id="sort-select" aria-label="排序方式">
          <option value="updated">最新动态优先</option>
          <option value="hot">讨论热度优先</option>
          <option value="created">最新发布优先</option>
        </select>
      </div>
    </section>

    <!-- 4. 预警卡片流 -->
    <section id="cards-grid" class="cards-grid">
      {
        issues.map((item) => {
          const meta = riskMeta[item.riskLevel] || riskMeta.archive;
          const updatedTs = new Date(item.updatedAt).getTime();
          const createdTs = new Date(item.createdAt).getTime();
          const hotScore = item.commentCount * 2 + item.reactionCount;
          const latestComment = item.latestComments && item.latestComments[0];
          const latestCommentPreview = latestComment
            ? latestComment.text
                .replace(/!\[[^\]]*\]\([^)]+\)/g, '[图片]')
                .replace(/<img\b[^>]*>/gi, '[图片]')
                .replace(/\s+/g, ' ')
                .trim()
            : '';
          const searchTokens = [
            `#${item.id}`,
            item.title,
            item.summary || '',
            ...(item.labels || []).map((l) => l.name),
            latestComment ? `${latestComment.author} ${latestCommentPreview}` : '',
          ].join(' ').toLowerCase();

          return (
            <article
              class="issue-card"
              data-risk={item.riskLevel}
              data-updated={updatedTs}
              data-created={createdTs}
              data-hot={hotScore}
              data-search-text={searchTokens}
            >
              <div class="card-top">
                <span class={`risk-badge ${meta.className}`}>{meta.label}</span>
                <span class="issue-meta">
                  #{item.id} · 更新于 {formatDate(item.updatedAt)}
                </span>
              </div>

              <h2 class="card-title">
                <a href={`/issue/${item.id}/`}>{item.title}</a>
              </h2>

              {item.labels && item.labels.length > 0 && (
                <div class="label-row">
                  {item.labels.map((label) => (
                    <span class="gh-label">{label.name}</span>
                  ))}
                </div>
              )}

              <p class="card-summary">
                {item.summary || '暂无正文描述，点击查看原贴详情。'}
              </p>

              {latestComment && (
                <div class="latest-comment">
                  <span class="comment-icon">💬</span>
                  <div class="comment-content">
                    <span class="comment-author">@{latestComment.author}：</span>
                    <span class="comment-text">{latestCommentPreview || '[图片]'}</span>
                  </div>
                </div>
              )}

              <div class="card-footer">
                <div class="metrics">
                  <span title="评论数">💬 {item.commentCount} 条讨论</span>
                  <span title="互动数">👀 {item.reactionCount}</span>
                </div>
                <div class="card-links">
                  <a href={`/issue/${item.id}/`} class="link-detail">
                    查看详情
                  </a>
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-github"
                    title="在 GitHub 查看原贴"
                  >
                    <svg class="gh-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    <span>原贴 ↗</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </section>

    <div id="empty-state" class="empty-state" style="display: none;">
      当前筛选条件下暂无匹配的预警记录。
    </div>

    <div class="load-more-wrap">
      <button id="load-more-btn" class="btn btn-ghost" style="display: none;">加载更多</button>
    </div>
  </div>
</Layout>

<!-- Pagefind 动态初始化 -->
<script is:inline>
  function setupPagefind() {
    const el = document.getElementById('pagefind-search');
    if (!el) return;

    function mountUI() {
      if (window.PagefindUI && !el.querySelector('.pagefind-ui')) {
        const fallbackInput = el.querySelector('input');
        const initialVal = fallbackInput ? fallbackInput.value : '';
        const wasFocused = document.activeElement === fallbackInput;

        el.innerHTML = '';
        new window.PagefindUI({
          element: '#pagefind-search',
          bundlePath: '/pagefind/',
          showSubResults: false,
          showImages: false,
          resetStyles: false,
          translations: {
            placeholder: '输入机场名称或失联、退款等关键词',
            zero_results: '未找到与“[SEARCH_TERM]”相关的跑路记录，建议核对别名或直接查看 GitHub 原仓库',
            many_results: '共找到 [COUNT] 条相关记录',
            one_result: '找到 1 条相关记录',
            clear_search: '清空',
            load_more: '加载更多结果',
          },
        });

        const newInput = el.querySelector('input');
        if (newInput) {
          if (initialVal) {
            newInput.value = initialVal;
            newInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
          if (wasFocused) {
            newInput.focus();
          }
        }
      }
    }

    if (window.PagefindUI) {
      mountUI();
    } else {
      let attempts = 0;
      const timer = setInterval(() => {
        attempts++;
        if (window.PagefindUI) {
          clearInterval(timer);
          mountUI();
        } else if (attempts >= 80) {
          clearInterval(timer);
        }
      }, 50);

      const existing = document.querySelector('script[src*="pagefind-ui.js"]');
      if (existing) {
        existing.addEventListener('load', mountUI);
      } else {
        const script = document.createElement('script');
        script.src = '/pagefind/pagefind-ui.js';
        script.onload = mountUI;
        document.head.appendChild(script);
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPagefind);
  } else {
    setupPagefind();
  }
</script>

<!-- 前端筛选、排序与分页逻辑 -->
<script>
  const PAGE_SIZE = 24;
  let currentRisk = 'all';
  let currentDays = 'all';
  let currentSort = 'updated';
  let currentQuery = '';
  let visibleLimit = PAGE_SIZE;

  const grid = document.getElementById('cards-grid') as HTMLElement;
  const allCards = Array.from(grid.querySelectorAll<HTMLElement>('.issue-card'));
  const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
  const timeFilter = document.getElementById('time-filter') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
  const searchWrap = document.getElementById('pagefind-search');

  function applyFilterAndSort() {
    const now = Date.now();
    const dayMs = 86400000;
    const queryTerms = currentQuery ? currentQuery.toLowerCase().split(/\s+/).filter(Boolean) : [];

    // 1. 过滤：分类、时间范围与关键词检索
    const matched = allCards.filter((card) => {
      const risk = card.dataset.risk || 'archive';
      const updated = Number(card.dataset.updated || 0);

      if (currentRisk !== 'all' && risk !== currentRisk) return false;
      if (currentDays !== 'all') {
        const limitMs = Number(currentDays) * dayMs;
        if (now - updated > limitMs) return false;
      }

      if (queryTerms.length > 0) {
        const searchText = (card.dataset.searchText || card.textContent || '').toLowerCase();
        const matchesAll = queryTerms.every((term) => searchText.includes(term));
        if (!matchesAll) return false;
      }

      return true;
    });

    // 2. 排序
    matched.sort((a, b) => {
      const key = currentSort === 'hot' ? 'hot' : currentSort === 'created' ? 'created' : 'updated';
      return Number(b.dataset[key] || 0) - Number(a.dataset[key] || 0);
    });

    // 3. 严格显隐控制（同时设置 hidden 与 display 样式，杜绝 display:flex 样式冲突导致不生效）
    allCards.forEach((card) => {
      card.hidden = true;
      card.style.display = 'none';
    });

    matched.forEach((card, index) => {
      const isVisible = index < visibleLimit;
      card.hidden = !isVisible;
      card.style.display = isVisible ? 'flex' : 'none';
      grid.appendChild(card);
    });

    const hasMatch = matched.length > 0;
    emptyState.style.display = hasMatch ? 'none' : 'block';
    if (!hasMatch) {
      if (currentQuery) {
        emptyState.textContent = `未找到与“${currentQuery}”相关的预警记录。`;
      } else {
        emptyState.textContent = '当前筛选条件下暂无匹配的预警记录。';
      }
    }
    
    const canLoadMore = matched.length > visibleLimit;
    loadMoreBtn.style.display = canLoadMore ? 'inline-flex' : 'none';
    if (canLoadMore) {
      loadMoreBtn.textContent = `加载更多（剩余 ${matched.length - visibleLimit} 条）`;
    }
  }

  // 绑定搜索输入事件（兼容 PagefindUI 渲染前后的 input）
  if (searchWrap) {
    searchWrap.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      if (target && target.tagName === 'INPUT') {
        currentQuery = target.value.trim();
        visibleLimit = PAGE_SIZE;
        applyFilterAndSort();
      }
    });

    searchWrap.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.pagefind-ui__search-clear')) {
        currentQuery = '';
        visibleLimit = PAGE_SIZE;
        applyFilterAndSort();
      }
    });

    searchWrap.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        currentQuery = '';
        visibleLimit = PAGE_SIZE;
        applyFilterAndSort();
      }
    });
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      currentRisk = pill.dataset.risk || 'all';
      visibleLimit = PAGE_SIZE;
      applyFilterAndSort();
    });
  });

  timeFilter.addEventListener('change', () => {
    currentDays = timeFilter.value;
    visibleLimit = PAGE_SIZE;
    applyFilterAndSort();
  });

  sortSelect.addEventListener('change', () => {
    currentSort = sortSelect.value;
    visibleLimit = PAGE_SIZE;
    applyFilterAndSort();
  });

  loadMoreBtn.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    applyFilterAndSort();
  });

  // 检查是否为用户主动刷新主页（重新刷新主页）
  const navEntries = performance.getEntriesByType('navigation');
  const isReload = navEntries.length > 0 && (navEntries[0] as PerformanceNavigationTiming).type === 'reload';

  if (isReload) {
    // 重新刷新主页：清除临时缓存状态并通知 Service Worker 更新远端内容
    try {
      sessionStorage.removeItem('paolu_home_state');
      if (navigator.serviceWorker?.controller) {
        navigator.serviceWorker.controller.postMessage({ type: 'REFRESH_HOME' });
      }
    } catch (e) {}
  } else {
    // 从详情页返回主页：恢复之前临时缓存的筛选条件、展示条数与滚动位置
    try {
      const savedState = sessionStorage.getItem('paolu_home_state');
      if (savedState) {
        const state = JSON.parse(savedState);
        if (state.risk) currentRisk = state.risk;
        if (state.days) currentDays = state.days;
        if (state.sort) currentSort = state.sort;
        if (state.limit) visibleLimit = Math.max(PAGE_SIZE, Number(state.limit) || PAGE_SIZE);

        pills.forEach((p) => {
          p.classList.toggle('active', (p.dataset.risk || 'all') === currentRisk);
        });
        if (timeFilter) timeFilter.value = currentDays;
        if (sortSelect) sortSelect.value = currentSort;

        if (state.query) {
          currentQuery = state.query;
          const inp = searchWrap?.querySelector<HTMLInputElement>('input');
          if (inp) {
            inp.value = currentQuery;
            inp.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }

        if (state.scroll) {
          requestAnimationFrame(() => {
            window.scrollTo({ top: Number(state.scroll), behavior: 'instant' });
          });
        }
      }
    } catch (e) {}
  }

  // 保存主页当前临时缓存状态到 sessionStorage
  function saveHomeState() {
    try {
      sessionStorage.setItem(
        'paolu_home_state',
        JSON.stringify({
          risk: currentRisk,
          days: currentDays,
          sort: currentSort,
          query: currentQuery,
          limit: visibleLimit,
          scroll: window.scrollY,
        })
      );
    } catch (e) {}
  }

  window.addEventListener('pagehide', saveHomeState);
  window.addEventListener('beforeunload', saveHomeState);
  grid.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      saveHomeState();
    }
  });

  // 初始渲染
  applyFilterAndSort();
</script>

<style>
  /* 解决 display: flex 覆盖 html5 hidden 属性的根本问题 */
  [hidden],
  .issue-card[hidden] {
    display: none !important;
  }

  /* KPI 网格：无边框设计，恢复原本各卡片专属颜色与微光特效 */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }

  .kpi-card {
    background: var(--surface);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: none; /* 无边框线 */
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: all 0.2s ease;
  }

  .kpi-card:hover {
    transform: translateY(-2px);
  }

  /* 当前高危预警：红色特效，无边框 */
  .kpi-danger {
    background: linear-gradient(180deg, rgba(239, 68, 68, 0.14), var(--surface));
    box-shadow: 0 4px 20px rgba(239, 68, 68, 0.08);
  }
  .kpi-danger:hover {
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.18);
  }
  .kpi-danger .kpi-value {
    color: var(--risk-high-text);
    text-shadow: 0 0 16px rgba(239, 68, 68, 0.35);
  }

  /* 近 7 天活跃反馈：橙黄色特效，无边框 */
  .kpi-warn {
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.14), var(--surface));
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.08);
  }
  .kpi-warn:hover {
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.18);
  }
  .kpi-warn .kpi-value {
    color: var(--risk-warn-text);
    text-shadow: 0 0 16px rgba(245, 158, 11, 0.35);
  }

  /* 累计收录线索：白色微光特效，无边框 */
  .kpi-total {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.10), var(--surface));
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.06);
  }
  .kpi-total:hover {
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.14);
  }
  .kpi-total .kpi-value {
    color: #ffffff;
    text-shadow: 0 0 16px rgba(255, 255, 255, 0.35);
  }

  /* 最后同步：绿色特效，无边框 */
  .kpi-sync {
    background: linear-gradient(180deg, rgba(16, 185, 129, 0.14), var(--surface));
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.08);
  }
  .kpi-sync:hover {
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.18);
  }
  .kpi-sync .kpi-value {
    color: var(--accent);
    text-shadow: 0 0 16px rgba(16, 185, 129, 0.35);
  }

  .kpi-label {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .kpi-value {
